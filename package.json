{
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "~8.0.1",
    "autoprefixer": "^10.5.2",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-terser": "^2.1.0",
    "merge-stream": "^2.0.0",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.19"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "browsers": [
              "> 1%",
              "last 2 versions"
            ]
          }
        }
      ],
      [
        "@babel/preset-react",
        {
          "runtime": "classic"
        }
      ]
    ]
  },
  "scripts": {
    "build:headline": "babel assets/headline/frontblocks-headline-option.jsx --out-file assets/headline/frontblocks-headline.js",
    "build:carousel": "babel assets/carousel/frontblocks-advanced-option.jsx --out-file assets/carousel/frontblocks-advanced-option.js",
    "build:animations": "babel assets/animations/frontblocks-animation-option.jsx --out-file assets/animations/frontblocks-animation-option.js",
    "build:sticky": "babel assets/sticky-column/frontblocks-sticky-column-option.jsx --out-file assets/sticky-column/frontblocks-sticky-column-option.js",
    "build:gallery": "babel assets/gallery/frontblocks-gallery-option.jsx --out-file assets/gallery/frontblocks-gallery-option.js",
    "build:post": "babel assets/insert-post/frontblocks-insert-post-option.jsx --out-file assets/insert-post/frontblocks-insert-post-option.js",
    "build:product-categories": "babel assets/product-categories/frontblocks-product-categories-option.jsx --out-file assets/product-categories/frontblocks-product-categories.js",
    "build:reading-time": "babel assets/reading-time/frontblocks-reading-time-option.jsx --out-file assets/reading-time/frontblocks-reading-time.js",
    "build:stacked-images": "babel assets/stacked-images/frontblocks-stacked-images-option.jsx --out-file assets/stacked-images/frontblocks-stacked-images.js",
    "build:edge-alignment": "babel assets/container-edge-alignment/frontblocks-edge-alignment-option.jsx --out-file assets/container-edge-alignment/frontblocks-edge-alignment.js",
    "build:shape-animations": "babel assets/shape-animations/frontblocks-shape-animation-option.jsx --out-file assets/shape-animations/frontblocks-shape-animation-option.js",
    "build:gf-inline": "babel assets/gravityforms-inline/frontblocks-gf-inline-option.jsx --out-file assets/gravityforms-inline/frontblocks-gf-inline-option.js",
    "build:faq-schema": "babel assets/faq-schema/frontblocks-faq-schema-option.jsx --out-file assets/faq-schema/frontblocks-faq-schema.js",
    "build:text-animation": "babel assets/text-animation/frontblocks-text-animation-option.jsx --out-file assets/text-animation/frontblocks-text-animation.js",
    "build:before-after": "babel assets/before-after/frontblocks-before-after-option.jsx --out-file assets/before-after/frontblocks-before-after.js",
    "build:user-text": "babel assets/user-text/frontblocks-user-text-option.jsx --out-file assets/user-text/frontblocks-user-text.js",
    "build:columns-same-height": "babel assets/columns-same-height/frontblocks-columns-same-height-option.jsx --out-file assets/columns-same-height/frontblocks-columns-same-height-option.js",
    "build:css": "postcss assets/admin/settings-src.css -o assets/admin/settings.css",
    "watch:css": "postcss assets/admin/settings-src.css -o assets/admin/settings.css --watch",
    "build:download-button": "babel assets/download-button/frontblocks-download-button-option.jsx --out-file assets/download-button/frontblocks-download-button-option.js",
    "build:css": "postcss assets/admin/settings-src.css -o assets/admin/settings.css",
    "watch:css": "postcss assets/admin/settings-src.css -o assets/admin/settings.css --watch",
    "build": "npm run build:carousel && npm run build:animations && npm run build:sticky && npm run build:gallery && npm run build:post && npm run build:headline && npm run build:product-categories && npm run build:reading-time && npm run build:stacked-images && npm run build:edge-alignment && npm run build:shape-animations && npm run build:gf-inline && npm run build:faq-schema && npm run build:before-after && npm run build:text-animation && npm run build:user-text && npm run build:download-button && npm run build:columns-same-height && npm run build:css"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.7"
  }
}
