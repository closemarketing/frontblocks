{
	"compilerOptions": {
		"target": "ES2019",
		"module": "commonjs",
		"lib": ["ES2019", "DOM"],
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"outDir": "tests/e2e/dist",
		"rootDir": ".",
		"types": ["node"]
	},
	"include": [
		"playwright.config.ts",
		"tests/e2e/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}
