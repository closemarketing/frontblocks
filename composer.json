{
	"name": "close/frontblocks",
	"description": "Plugin to use the Gutenberg blocks in the front of the site",
	"homepage": "https://close.technology/",
	"license": "GPL-2.0-or-later",
	"config": {
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpcompatibility/phpcompatibility-wp": "^2",
		"sirbrillig/phpcs-variable-analysis": "^2",
		"wp-coding-standards/wpcs": "^3.2",
		"phpcsstandards/phpcsutils": "^1.x-dev",
		"phpunit/phpunit": "^7",
		"yoast/phpunit-polyfills": "^1.0",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"phpstan/extension-installer": "^1.4"
	},
	"autoload": {
		"psr-4": {
			"FrontBlocks\\": "includes/"
		}
	},
	"scripts": {
		"format": "phpcbf --standard=phpcs.xml.dist",
		"lint": "phpcs --standard=phpcs.xml.dist",
		"phpstan": "phpstan analyse --memory-limit=2048M"
	}
}